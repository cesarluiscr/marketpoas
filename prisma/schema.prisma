// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  image     String?
  phone     String?
  emailVerified DateTime?
  // Rol y contraseña (solo admin tiene password)
  role           String   @default("vecino") // vecino | admin
  passwordHash   String?
  // KYC básico
  kycStatus      String   @default("no_verificado") // no_verificado | pendiente | verificado | rechazado
  kycIdImage     String?  // URL de la foto de cédula
  kycSelfieImage String?  // URL del selfie con cédula
  kycSubmittedAt DateTime?
  kycReviewedAt  DateTime?
  kycRejectReason String?
  // Preferencias
  theme          String   @default("light") // light | dark
  // Notificaciones push
  pushSubscription String?  // JSON con suscripción a Web Push
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts  Account[]
  sessions  Session[]
  listings  Listing[]
  messagesSent     Message[] @relation("MessageFrom")
  messagesReceived Message[] @relation("MessageTo")
  conversationsFrom Conversation[] @relation("ConvFrom")
  conversationsTo   Conversation[] @relation("ConvTo")
  favorites        Favorite[]
  offersMade       Offer[]  @relation("OfferFrom")
  offersReceived   Offer[]  @relation("OfferTo")
  questionsAsked   Question[] @relation("QFrom")
  questionsAnswered Question[] @relation("QTo")
  reviewsGiven     Review[]  @relation("ReviewFrom")
  reviewsReceived Review[]  @relation("ReviewTo")
  savedSearches    SavedSearch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id          String   @id @default(cuid())
  type        String   // "venta" | "compra"
  title       String
  description String
  price       Float
  currency    String   @default("CRC")
  category    String
  condition   String   @default("usado")
  location    String   @default("Poás")
  lat         Float?
  lng         Float?
  imageUrl    String?
  contactName String
  contactPhone String
  contactWhatsapp String?
  status      String   @default("activo")
  userId      String?
  views       Int      @default(0)
  promoted    Boolean  @default(false)
  promotedUntil DateTime?
  // Negociación e intercambio
  negotiable  Boolean  @default(false)
  exchangeFor String?  // Si acepta trueque, qué busca a cambio
  previousPrice Float? // Si bajó el precio, mostrar antes
  // Campos personalizados (meta) por categoría
  metaKm        Int?      // Vehículos: kilometraje
  metaYear      Int?      // Vehículos: año
  metaBrand     String?   // Vehículos/Tecnología: marca
  metaModel     String?   // Vehículos/Tecnología: modelo
  metaAreaM2    Int?      // Inmuebles: área en m²
  metaBedrooms  Int?      // Inmuebles: habitaciones
  metaBathrooms Int?      // Inmuebles: baños
  metaSize      String?   // Ropa/Tecnología: talla
  metaWeight    String?   // Alimentos: peso (ej: "5 libras")
  metaCapacity  String?   // Electrodomésticos: capacidad
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  favorites   Favorite[]
  offers      Offer[]
  questions   Question[]
  reports     Report[]

  @@index([type])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([promoted])
}

model Conversation {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId  String
  toUserId    String
  fromUser    User     @relation("ConvFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("ConvTo", fields: [toUserId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime @default(now())
  createdAt   DateTime @default(now())
  messages    Message[]

  @@unique([listingId, fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUserId     String
  toUserId       String
  fromUser       User     @relation("MessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser         User     @relation("MessageTo", fields: [toUserId], references: [id], onDelete: Cascade)
  body           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([toUserId, read])
}

// === Nuevas funcionalidades ===

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

model Offer {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User    @relation("OfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User    @relation("OfferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  amount     Float
  message    String?
  status     String  @default("pendiente") // pendiente | aceptada | rechazada
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([listingId])
  @@index([toUserId, status])
}

model Question {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User    @relation("QFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User    @relation("QTo", fields: [toUserId], references: [id], onDelete: Cascade)
  body       String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@index([toUserId, answeredAt])
}

model Review {
  id        String   @id @default(cuid())
  fromUserId String
  fromUser   User    @relation("ReviewFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User    @relation("ReviewTo", fields: [toUserId], references: [id], onDelete: Cascade)
  rating     Int     // 1 a 5
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  search    String?
  type      String?  // venta | compra
  category  String?
  location  String?
  minPrice  Float?
  maxPrice  Float?
  lastNotifiedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

model Report {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId  String?
  reason      String   // spam | fraude | estafa | contenido inapropiado | otro
  details     String?
  status      String   @default("pendiente") // pendiente | revisado | descartado
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([status])
}

// === Nuevas funcionalidades ===

model Business {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String?
  category    String   // comercio | restaurante | servicios | feria | taller
  address     String?
  phone       String?
  whatsapp    String?
  email       String?
  imageUrl    String?
  logoUrl     String?
  // Horario (JSON: {mon:"8-18", tue:"8-18"...})
  hours       String?
  location    String?
  lat         Float?
  lng         Float?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([verified])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  location    String?
  address     String?
  lat         Float?
  lng         Float?
  imageUrl    String?
  organizer   String?
  category    String   // feria | tope | fiesta_civica | cultural | deportivo | religioso
  free        Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([category])
}

model Bulletin {
  id          String   @id @default(cuid())
  title       String
  body        String
  type        String   // aviso | alerta | cierre_via | actividad | ayuda
  priority    String   @default("normal") // normal | alta | urgente
  imageUrl    String?
  author      String   @default("Municipalidad de Poás")
  publishUntil DateTime?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([priority])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // offer | message | question | review | system | favorite
  title       String
  body        String?
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}
