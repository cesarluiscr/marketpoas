{
  "framework": "nextjs",
  "buildCommand": "bun run build && bash scripts/postbuild.sh",
  "installCommand": "bun install",
  "env": {
    "DATABASE_URL": "postgresql://neondb_owner:npg_FPQojKl8wG6L@ep-curly-heart-bboh9ot5-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require",
    "NEXTAUTH_SECRET": "marketpoas-secret-key-2026-tech-center-cr"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=*, microphone=*, geolocation=*" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
